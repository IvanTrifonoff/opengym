# openGym network deployment — environment variables
# Copy to .env and fill in real values. NEVER commit .env.

# --- WebAuthn ---
RP_ID=gym.trfnv.ru              # relying party id (domain, no scheme)
ORIGIN=https://gym.trfnv.ru     # allowed origin
RP_NAME=openGym
SESSION_DAYS=90                 # session cookie lifetime

# --- App ---
WEB_PORT=8080                   # published web port (8080 on host -> 80 in container)
ADMIN_UIDS=                     # legacy comma-separated athlete uids with admin flag
INVITE_ONLY=true                # gate new signups behind an invite code

# --- Push notifications ---
VAPID_SUBJECT=mailto:admin@example.com

# --- PostgreSQL (loyalty/access integration) ---
# Points at an existing Postgres container (e.g. retail_db) via its docker network.
# DB and role opengym are created separately; the app creates its own tables.
DATABASE_URL=postgres://opengym:CHANGE_ME@retail_db:5432/opengym

# --- Webhook integration (SCUD / access control / CRM) ---
# Required header: X-OpenGym-Webhook-Secret: <this value>
ACCESS_WEBHOOK_SECRET=generate-a-long-random-string
